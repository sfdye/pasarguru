# ─── Android: Google Play metadata ───────────────────────────────────────
# EAS owns builds and binary submission. This lane pushes listing text and screenshots.
# iOS store state is managed by scripts/store-ios.mjs (the `asc` CLI), not fastlane.
#
# To pull existing metadata: fastlane supply init
platform :android do
  desc "Push metadata to Google Play (no binary)"
  lane :metadata do
    supply(
      skip_upload_aab: true,
      skip_upload_apk: true,
      skip_upload_changelogs: true,
      track: "internal",
      metadata_path: "fastlane/metadata/android",
    )
  end
end
