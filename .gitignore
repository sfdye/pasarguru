# dependencies
node_modules/

# Expo
.expo/
dist/
expo-env.d.ts

# local build artifacts — `eas build --local` writes these to the repo root
/*.ipa
/*.apk
/*.aab

# generated native projects — regenerate from app.json with `expo prebuild`
/ios
/android

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# secrets
.env
.env.*

# typescript
*.tsbuildinfo

# git worktrees — local checkouts with their own node_modules, never needed by EAS
.worktrees/

# tooling
.playwright-mcp/
.claude/

# fastlane — credentials and generated reports (Android only; iOS store state lives in store/ios via the asc CLI)
fastlane/report.xml
fastlane/Preview.html
fastlane/play-service-account.json
fastlane/README.md
store/ios/asc-api-key.json

# lib/ here is source, not build output — some global ignore files exclude it by convention
!/lib/

# scripts — generated output from hours fetcher
scripts/nea-markets.json
scripts/market-hours-api.json
